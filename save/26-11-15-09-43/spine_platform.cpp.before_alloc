/**
 ****************************************************************************************************
 * @file        spine_platform.cpp
 * @brief       spine-cpp 平台层实现：SDRAM first-fit 分配器 + getDefaultExtension() + FatFs 读文件
 * @note        为什么不用 C 库 malloc：栈/堆默认很小（Heap_Size=0），而 spine 解析一个骨架动辄
 *              几十到几百 KB。这里直接在 SDRAM 开 8 MB 池，自带分配器，完全绕开 C 库堆。
 ****************************************************************************************************
 */

#include <string.h>
#include <stdio.h>

#include "spine_platform.h"

extern "C"
{
#include "./SYSTEM/sys/sys.h"
#include "./FATFS/source/ff.h"
}

#include <spine/Extension.h>
#include <spine/SpineString.h>

/*----------------------------------------------------------------- 简单 first-fit 分配器 */

namespace
{

struct Block
{
    uint32_t size;          /* 可用字节数（不含本头部） */
    Block   *next;
    uint32_t free;
};

Block *g_head = nullptr;

uint32_t g_used = 0;
uint32_t g_peak = 0;
uint32_t g_allocs = 0;
uint32_t g_fails = 0;

const uint32_t HDR = (uint32_t)((sizeof(Block) + 7u) & ~7u);

void heap_init()
{
    g_head = (Block *)SPINE_HEAP_BASE;
    g_head->size = SPINE_HEAP_SIZE - HDR;
    g_head->next = nullptr;
    g_head->free = 1;
}

inline void *payload(Block *b)
{
    return (void *)((uint8_t *)b + HDR);
}

inline Block *header_of(void *p)
{
    return (Block *)((uint8_t *)p - HDR);
}

void *heap_alloc(size_t n)
{
    if (g_head == nullptr)
    {
        heap_init();
    }

    n = (n + 7u) & ~7u;

    if (n == 0)
    {
        n = 8;
    }

    for (Block *b = g_head; b != nullptr; b = b->next)
    {
        if ((b->free != 0u) && (b->size >= n))
        {
            /* 够大就切一块出来 */
            if (b->size >= (n + HDR + 32u))
            {
                Block *nb = (Block *)((uint8_t *)b + HDR + n);

                nb->size = b->size - n - HDR;
                nb->next = b->next;
                nb->free = 1;
                b->next = nb;
                b->size = n;
            }

            b->free = 0;
            g_used += b->size + HDR;
            g_allocs++;

            if (g_used > g_peak)
            {
                g_peak = g_used;
            }
            return payload(b);
        }
    }

    g_fails++;
    return nullptr;
}

void heap_free(void *p)
{
    if (p == nullptr)
    {
        return;
    }

    Block *b = header_of(p);

    if (b->free != 0u)
    {
        return;                         /* 重复释放：直接忽略 */
    }

    b->free = 1;
    g_used -= (b->size + HDR);

    /* 向后合并 */
    if ((b->next != nullptr) && (b->next->free != 0u))
    {
        b->size += HDR + b->next->size;
        b->next = b->next->next;
    }

    /* 向前合并：从头扫一遍（block 少，代价可接受） */
    for (Block *q = g_head; q != nullptr; q = q->next)
    {
        if ((q != b) && (q->free != 0u) && (q->next == b))
        {
            q->size += HDR + b->size;
            q->next = b->next;
            b = q;
            break;
        }
    }
}

void *heap_realloc(void *p, size_t n)
{
    if (p == nullptr)
    {
        return heap_alloc(n);
    }
    if (n == 0)
    {
        heap_free(p);
        return nullptr;
    }

    Block *b = header_of(p);
    Block *nb = header_of(heap_alloc(n));

    if (nb == nullptr)
    {
        return nullptr;
    }

    size_t copy = b->size < n ? b->size : n;

    memcpy(payload(nb), p, copy);
    heap_free(p);
    return payload(nb);
}

/*----------------------------------------------------------------- Spine 扩展 */

class SpineMcuExtension : public spine::SpineExtension
{
public:
    SpineMcuExtension()
    {
        heap_init();
    }

    void *_alloc(size_t size, const char *file, int line) override
    {
        (void)file;
        (void)line;
        return heap_alloc(size);
    }

    void *_calloc(size_t size, const char *file, int line) override
    {
        (void)file;
        (void)line;

        void *p = heap_alloc(size);

        if (p != nullptr)
        {
            memset(p, 0, size);
        }
        return p;
    }

    void *_realloc(void *ptr, size_t size, const char *file, int line) override
    {
        (void)file;
        (void)line;
        return heap_realloc(ptr, size);
    }

    void _free(void *mem, const char *file, int line) override
    {
        (void)file;
        (void)line;
        heap_free(mem);
    }

    /** 从 SD 卡（FatFs）整体读入一个文件，语义与 spine 默认实现一致：返回 malloc 区，调用方负责 free */
    char *_readFile(const spine::String &path, int *length) override
    {
        FIL  fil;
        UINT br = 0;
        char name[128];
        int  n = path.length();

        if ((length == nullptr) || (n <= 0) || (n >= (int)sizeof(name)))
        {
            return nullptr;
        }

        for (int i = 0; i < n; i++)
        {
            name[i] = path.buffer()[i];
        }
        name[n] = '\0';

        if (f_open(&fil, name, FA_READ) != FR_OK)
        {
            /* 回退：文件若放在卡根目录（而不是 /spine/ 下），用 basename 再试一次 */
            const char *base = strrchr(name, '/');

            if ((base == nullptr) || (f_open(&fil, base + 1, FA_READ) != FR_OK))
            {
                return nullptr;
            }
        }

        FSIZE_t sz = f_size(&fil);

        if ((sz == 0) || (sz > (FSIZE_t)(4 * 1024 * 1024)))
        {
            f_close(&fil);
            return nullptr;
        }

        char *buf = (char *)heap_alloc((size_t)sz);

        if (buf == nullptr)
        {
            f_close(&fil);
            return nullptr;
        }

        if ((f_read(&fil, buf, (UINT)sz, &br) != FR_OK) || (br != (UINT)sz))
        {
            heap_free(buf);
            f_close(&fil);
            return nullptr;
        }

        f_close(&fil);

        *length = (int)sz;
        return buf;
    }
};

/* 给惰性构造的 extension 用的静态存储（避免依赖堆/全局构造） */
struct BufferForExtension
{
    alignas(16) unsigned char bytes[sizeof(SpineMcuExtension)];
};

}  /* namespace */

/* spine-cpp 要求由平台提供此函数 */
namespace spine
{
SpineExtension *getDefaultExtension()
{
    /* 必须惰性构造：SDRAM 控制器在 main() 里才初始化，
     * 若做成全局对象，其构造函数会在 SDRAM 就绪前写 0xC0200000 导致死机。 */
    static SpineMcuExtension *ext = nullptr;

    if (ext == nullptr)
    {
        static BufferForExtension storage;          /* 静态存储，无需堆 */
        ext = new (&storage) SpineMcuExtension();
        SpineExtension::setInstance(ext);
    }
    return ext;
}
}

extern "C" void spine_heap_get_stats(spine_heap_stats_t *st)
{
    if (st == nullptr)
    {
        return;
    }

    st->used_bytes = g_used;
    st->peak_bytes = g_peak;
    st->alloc_count = g_allocs;
    st->fail_count = g_fails;
}

extern "C" uint32_t spine_heap_block_count(void)
{
    uint32_t n = 0;

    for (Block *b = g_head; b != nullptr; b = b->next)
    {
        n++;
    }
    return n;
}
